# Supabase Configuration (Separate Project for Salon System)
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co 
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=POSH Grooming Lounge

# Root domain for owned-domain salons (change this to rebrand without touching code)
# Booking:  {slug}.ROOT_DOMAIN           e.g. posh.blueoxgroup.eu
# System:   system-{slug}.ROOT_DOMAIN    e.g. system-posh.blueoxgroup.eu
NEXT_PUBLIC_ROOT_DOMAIN=blueoxgroup.eu

# WhatsApp/Messaging
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_PHONE_NUMBER=your-whatsapp-number

# ── SMS Provider ────────────────────────────────────────────────────────────
# Set SMS_PROVIDER to either "esms" or "africastalking"
SMS_PROVIDER=africastalking

# Africa's Talking (SMS_PROVIDER=africastalking)
# Sign up at https://account.africastalking.com
# Supports: MTN, Airtel, and all major networks across Africa
# Top-up: done manually via the AT dashboard (no API)
AT_API_KEY=your-at-api-key
AT_USERNAME=your-at-username
AT_SENDER_ID=your-registered-sender-id   # optional — leave blank to use default

# eSMS Africa (SMS_PROVIDER=esms)
# Sign up at https://esmsafrica.io
# Note: currently limited to Airtel numbers only
# Supports: balance API, sent message log, delivery stats, programmatic top-up
ESMS_API_KEY=your-esms-api-key
ESMS_ACCOUNT_ID=2416
# ────────────────────────────────────────────────────────────────────────────

# Email
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=notifications@poshsalon.com

# Mobile Money (Future - For Demo use simulation)
MTN_MOMO_API_KEY=your-mtn-api-key
AIRTEL_MONEY_API_KEY=your-airtel-api-key

#Imagekit
IMAGEKIT_PUBLIC_KEY=public_key
IMAGEKIT_PRIVATE_KEY=private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_APP_FOLDER=image_folder